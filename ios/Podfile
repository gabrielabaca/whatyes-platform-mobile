# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Google Sign-In: usar la librería precompilada estática para evitar el error
# "The Swift pod AppCheckCore depends upon GoogleUtilities... cannot be integrated
# as static libraries" al integrar el SDK de GoogleSignIn con la New Architecture.
$RNGoogleSigninAsStaticLibrary = true

# Firebase iOS entra por el mismo tronco que GoogleUtilities / AppCheckCore.
# NO activamos `use_frameworks! :linkage => :static` de forma global: WebRTC y
# AmazonIVSBroadcast se rompen con eso. `$RNFirebaseAsStaticFramework` +
# modular_headers (abajo) es el camino que convive con el workaround de Sign-In.
$RNFirebaseAsStaticFramework = true
# RNFB >= 26 resuelve Firebase por SPM por defecto, y eso es incompatible con
# static_framework (guard "SPM + static linkage is not supported"). Forzamos la
# resolución por CocoaPods, que es la que usan los pods FirebaseCore/... de abajo.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PulpoLive' do
  config = use_native_modules!

  # GoogleSignIn (login social) arrastra AppCheckCore, que depende de GoogleUtilities
  # y RecaptchaInterop sin module map → error "cannot be integrated as static
  # libraries". Habilitar modular headers para esos pods lo resuelve.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'AppCheckCore', :modular_headers => true
  # Firebase Messaging arrastra el mismo tronco (GoogleUtilities / nanopb).
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  # Amazon IVS Broadcast SDK (Real-Time Stages): publisher del seller y
  # subscriber de viewers cuando la sala usa video_transport=ivs (IvsStage.m).
  pod 'AmazonIVSBroadcast/Stages', '~> 1.37'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
