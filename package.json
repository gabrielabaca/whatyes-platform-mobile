{
  "name": "PulpoLive",
  "version": "0.0.9",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:rebuild": "bash scripts/android-rebuild.sh",
    "android:clean": "bash scripts/android-rebuild.sh && react-native run-android",
    "setup:android": "npx react-native-asset && bash scripts/android-rebuild.sh",
    "build:android": "bash scripts/android-rebuild.sh :app:bundleRelease",
    "build:android:apk": "bash scripts/android-rebuild.sh :app:assembleRelease",
    "ios": "react-native run-ios",
    "setup:ios": "npx react-native-asset && cd ios && pod install",
    "setup:native": "npm run setup:android && npm run setup:ios",
    "build:ios": "bundle exec fastlane build",
    "fastlane:beta": "bundle exec fastlane beta",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "metro:watchman-reset": "watchman watch-del-all 2>/dev/null; watchman shutdown-server 2>/dev/null; true",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@peculiar/webcrypto": "^1.5.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/fontawesome6": "^12.4.0",
    "@react-native/new-app-screen": "0.83.1",
    "amazon-kinesis-video-streams-webrtc": "^2.5.0",
    "crypto-js": "^4.2.0",
    "events": "^3.3.0",
    "fast-text-encoding": "^1.0.6",
    "i18next": "^25.10.5",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "node-libs-react-native": "^1.2.1",
    "react": "19.2.0",
    "react-i18next": "^16.6.2",
    "react-native": "0.83.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-config": "^1.6.1",
    "react-native-date-picker": "^5.0.13",
    "react-native-get-random-values": "^2.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-incall-manager": "^4.2.1",
    "react-native-keep-awake": "^4.0.0",
    "react-native-randombytes": "^3.6.2",
    "react-native-record-screen": "^0.6.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.1",
    "react-native-video": "^6.19.2",
    "react-native-view-shot": "^4.0.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webrtc": "^124.0.0",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
